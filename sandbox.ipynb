    "import os \n",
    "\n",
    "\n",
    "dir = 'data/converted_images_lro_gan/images/'\n",
    "\n",
    "#move all the images to its previous directory\n",
    "for filename in os.listdir(dir):\n",
    "    os.rename(dir+filename, 'data/converted_images_lro_gan/'+filename)\n",
    "os.rmdir(dir)\n",
    "print('done')"
   ]
  }
